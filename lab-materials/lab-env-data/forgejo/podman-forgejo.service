[Unit]
Description=Podman container - Forgejo Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root
TimeoutStartSec=300
ExecStartPre=-/usr/bin/podman rm -f forgejo
ExecStart=podman run --name forgejo --hostname infra.grid.lab -e USER_UID=1000 -e USER_GID=1000 -e FORGEJO__server__ROOT_URL=http://infra.grid.lab:3000 -e FORGEJO__server__SSH_PORT=2222 -e FORGEJO__server__SSH_LISTEN_PORT=22 -e FORGEJO__service__DISABLE_REGISTRATION=true -e FORGEJO__security__SECRET_KEY=97Vy1tGr1Ds5X9GVgbEdYuVx7CkGdoWam6fIRVgeKptAcLVB4Dg3DSVdmXAKz7et -e FORGEJO__security__INTERNAL_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJuYmYiOjE2NjkzODk4MjB9.h-Pr9FEOUZTYEuZeH1oajUMw7dtwNopiiSfwtNB36vk -e FORGEJO__security__INSTALL_LOCK=true -p 3000:3000 -p 2222:22 -v /opt/forgejo/:/data:Z -v /etc/localtime:/etc/localtime:ro quay.io/mavazque/forgejo:17
ExecStop=-/usr/bin/podman rm -f forgejo
Restart=always
RestartSec=30s
StartLimitInterval=60s
StartLimitBurst=99

[Install]
WantedBy=multi-user.target
